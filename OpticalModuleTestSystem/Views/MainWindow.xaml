<Window x:Class="OpticalModuleTestSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="光模块测试系统 V1.0"
        Height="880" Width="1180"
        WindowStartupLocation="CenterScreen" FontSize="14">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold"
                   HorizontalAlignment="Center" Margin="0 0 15 15">
            光模块自动化测试系统
        </TextBlock>

        <!-- ==================== GPIB 仪器状态区 ==================== -->
        <GroupBox Grid.Row="1" Header="GPIB 仪器连接与初始化" Margin="0 0 0 10" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <DataGrid x:Name="DataGrid_Instruments"
                          ItemsSource="{Binding Instruments}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          RowHeight="30">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="GPIB地址" Binding="{Binding GpibAddress}" Width="80"/>
                        <DataGridTextColumn Header="仪器名称" Binding="{Binding Name}" Width="150"/>
                        <DataGridTextColumn Header="型号" Binding="{Binding Model}" Width="150"/>
                        <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="120"/>
                        <DataGridTemplateColumn Header="状态灯" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Ellipse Width="16" Height="16" Fill="{Binding StatusColor}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="IDN信息" Binding="{Binding IdnString}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Column="1" Margin="15 0 0 0" VerticalAlignment="Center">
                    <Button Content="扫描仪器" Command="{Binding ScanInstrumentsCommand}" Width="130" Height="40" Margin="0 0 0 10"/>
                    <Button Content="一键初始化" Command="{Binding InitializeAllCommand}" Width="130" Height="40"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <Separator Grid.Row="2" Margin="0 10"/>

        <!-- ==================== DDM 光模块监控 + 告警规格 ==================== -->
        <GroupBox Grid.Row="3" Header="光模块 DDM 实时监控 + 规格告警" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左侧：实时参数 -->
                <StackPanel Grid.Column="0" Margin="0 0 20 0">
                    <TextBlock Text="实时监测值" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>

                    <TextBlock Text="温度" Margin="0 8 0 0"/>
                    <TextBox x:Name="Txt_Temp" IsReadOnly="True" Height="30" Background="#f8f9fa"/>

                    <TextBlock Text="电压" Margin="0 8 0 0"/>
                    <TextBox x:Name="Txt_Volt" IsReadOnly="True" Height="30" Background="#f8f9fa"/>

                    <TextBlock Text="偏置电流" Margin="0 8 0 0"/>
                    <TextBox x:Name="Txt_Bias" IsReadOnly="True" Height="30" Background="#f8f9fa"/>

                    <TextBlock Text="发射光功率" Margin="0 8 0 0"/>
                    <TextBox x:Name="Txt_TxPower" IsReadOnly="True" Height="30" Background="#f8f9fa"/>

                    <TextBlock Text="接收光功率" Margin="0 8 0 0"/>
                    <TextBox x:Name="Txt_RxPower" IsReadOnly="True" Height="30" Background="#f8f9fa"/>

                    <Button x:Name="Btn_AutoDDM" Content="自动读取DDM" Margin="0 15 0 0" Height="40"/>
                    <Button x:Name="Btn_StopDDM" Content="停止读取" Margin="0 10 0 0" Height="40"/>
                </StackPanel>

                <!-- 中间：规格值（告警阈值）-->
                <StackPanel Grid.Column="1" Margin="0 0 20 0">
                    <TextBlock Text="模块规格值(从DDM读取)" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>

                    <TextBlock Text="温度上限" Margin="0 8 0 0"/>
                    <TextBox x:Name="Txt_Temp_High" IsReadOnly="True" Height="30" Background="#f1f8e9"/>

                    <TextBlock Text="温度下限" Margin="0 8 0 0"/>
                    <TextBox x:Name="Txt_Temp_Low" IsReadOnly="True" Height="30" Background="#f1f8e9"/>

                    <TextBlock Text="电压上限" Margin="0 8 0 0"/>
                    <TextBox x:Name="Txt_Vcc_High" IsReadOnly="True" Height="30" Background="#f1f8e9"/>

                    <TextBlock Text="电压下限" Margin="0 8 0 0"/>
                    <TextBox x:Name="Txt_Vcc_Low" IsReadOnly="True" Height="30" Background="#f1f8e9"/>

                    <TextBlock Text="TxPower 上限" Margin="0 8 0 0"/>
                    <TextBox x:Name="Txt_TxPower_High" IsReadOnly="True" Height="30" Background="#f1f8e9"/>

                    <TextBlock Text="TxPower 下限" Margin="0 8 0 0"/>
                    <TextBox x:Name="Txt_TxPower_Low" IsReadOnly="True" Height="30" Background="#f1f8e9"/>
                </StackPanel>

                <!-- 右侧：模块信息 + 告警状态 -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="模块信息" FontSize="16" FontWeight="Bold" Margin="0 0 0 10"/>

                    <TextBlock Text="生产厂家" Margin="0 8 0 0"/>
                    <TextBox x:Name="Txt_Manufacturer" IsReadOnly="True" Height="30" Background="#f8f9fa"/>

                    <TextBlock Text="模块型号" Margin="0 8 0 0"/>
                    <TextBox x:Name="Txt_Model" IsReadOnly="True" Height="30" Background="#f8f9fa"/>

                    <TextBlock Text="序列号 SN" Margin="0 8 0 0"/>
                    <TextBox x:Name="Txt_SN" IsReadOnly="True" Height="30" Background="#f8f9fa"/>

                    <TextBlock Text="生产日期" Margin="0 8 0 0"/>
                    <TextBox x:Name="Txt_Date" IsReadOnly="True" Height="30" Background="#f8f9fa"/>

                    <TextBlock Text="告警状态" FontWeight="Bold" Margin="0 15 0 5"/>
                    <TextBox x:Name="Txt_AlarmStatus" IsReadOnly="True" Height="50" Background="#fff3e0" FontSize="13"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 状态栏 -->
        <TextBlock x:Name="Txt_Status" Grid.Row="4" Margin="5 0" VerticalAlignment="Center"/>
    </Grid>
</Window>